        </mxCell>
        <mxCell id="PE4" style="endArrow=classic;strokeColor=#9575CD;strokeWidth=1;dashed=1;" edge="1" source="PG3" target="PG4" parent="LL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="PGL" value="&lt;i style=&quot;font-size:8px&quot;&gt;PPR lan truyền qua KG&lt;br&gt;w(edge) điều chỉnh theo intent&lt;/i&gt;" style="text;html=1;fontSize=8;fontFamily=Times New Roman;fontColor=#7986CB;" vertex="1" parent="LL">
          <mxGeometry x="310" y="205" width="160" height="25" as="geometry"/>
        </mxCell>

        <!-- Low-level merge -->
        <mxCell id="LM" value="&lt;b&gt;s_low&lt;/b&gt; = Σ wᵢ · sᵢ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#0D47A1;" vertex="1" parent="LL">
          <mxGeometry x="540" y="155" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Arrows from 4 signals to merge -->
        <mxCell id="LA1" style="endArrow=classic;strokeColor=#999;curved=1;" edge="1" source="KP" target="LM" parent="LL">
