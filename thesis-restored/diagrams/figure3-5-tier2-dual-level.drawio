        <mxCell id="KS2" style="endArrow=classic;strokeColor=#CCC;dashed=1;" edge="1" source="KP" target="CM" parent="LL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Weight annotation -->
        <mxCell id="WA" value="&lt;span style=&quot;font-size:8px&quot;&gt;w_kp=0.05 · w_sem=0.20 · &lt;b&gt;w_ppr=0.25&lt;/b&gt; · w_con=0.20&lt;/span&gt;" style="text;html=1;fontSize=8;fontFamily=Times New Roman;fontColor=#666;" vertex="1" parent="LL">
          <mxGeometry x="390" y="255" width="290" height="15" as="geometry"/>
        </mxCell>

        <!-- ===== HIGH-LEVEL SWIMLANE ===== -->
        <mxCell id="HL" value="&lt;b&gt;High-level (Conceptual)&lt;/b&gt;" style="swimlane;html=1;startSize=25;fillColor=#FFF;strokeColor=#E65100;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#BF360C;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="340" width="700" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="TM" value="&lt;b&gt;⑤ Theme Matching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;FAISS top-10 cụm → entities → điều khoản&lt;br&gt;w = 0.15&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontFamily=Times New Roman;fontSize=10;fontColor=#BF360C;" vertex="1" parent="HL">
          <mxGeometry x="20" y="40" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="HE" value="&lt;b&gt;⑥ Hierarchy Expansion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Cùng entity type, hệ số suy giảm ×0.5&lt;br&gt;w = 0.15&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontFamily=Times New Roman;fontSize=10;fontColor=#BF360C;" vertex="1" parent="HL">
          <mxGeometry x="320" y="40" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- High-level merge -->
        <mxCell id="HM" value="&lt;b&gt;s_high&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#BF360C;" vertex="1" parent="HL">
          <mxGeometry x="590" y="50" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="HA1" style="endArrow=classic;strokeColor=#E65100;" edge="1" source="TM" target="HM" parent="HL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="HA2" style="endArrow=classic;strokeColor=#E65100;" edge="1" source="HE" target="HM" parent="HL">
