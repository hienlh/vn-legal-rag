        <mxCell id="TE" style="endArrow=classic;strokeColor=#CCC;dashed=1;" edge="1" source="TM" target="HE" parent="HL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== FINAL MERGE ===== -->
        <mxCell id="FM" value="&lt;b&gt;s(a) = 0.70 · s_low + 0.15 · s_theme + 0.15 · s_hier&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Times New Roman;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="340" y="530" width="420" height="45" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="OUT" value="&lt;i&gt;Đầu ra C₂&lt;/i&gt;&lt;br&gt;&lt;b&gt;Danh sách điều khoản xếp hạng → Tầng 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;fontFamily=Times New Roman;fontSize=10;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="420" y="610" width="260" height="45" as="geometry"/>
        </mxCell>

        <!-- Edges: input to swimlanes -->
        <mxCell id="EI1" style="endArrow=classic;strokeColor=#555;" edge="1" source="QI" target="LL" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="EI2" style="endArrow=classic;strokeColor=#555;" edge="1" source="QI" target="HL" parent="1">
