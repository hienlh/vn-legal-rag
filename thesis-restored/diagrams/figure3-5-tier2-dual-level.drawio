        <mxCell id="PG3" value="e₂" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontFamily=Times New Roman;fontSize=9;" vertex="1" parent="LL">
          <mxGeometry x="400" y="170" width="45" height="30" as="geometry"/>
