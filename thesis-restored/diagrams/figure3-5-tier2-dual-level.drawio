<mxfile host="app.diagrams.net">
  <diagram id="fig3-5" name="Hình 3.5 – Tầng 2: Truy xuất ngữ nghĩa hai cấp">
    <mxGraphModel dx="1300" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title: Query input -->
        <mxCell id="QI" value="&lt;i&gt;Từ Query Analysis&lt;/i&gt;&lt;br&gt;&lt;b&gt;seeds, intent, expanded_q&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#BF360C;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== LOW-LEVEL SWIMLANE ===== -->
        <mxCell id="LL" value="&lt;b&gt;Low-level (Entity-specific)&lt;/b&gt;" style="swimlane;html=1;startSize=25;fillColor=#FFF;strokeColor=#1565C0;strokeWidth=2;fontFamily=Times New Roman;fontSize=11;fontColor=#0D47A1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="290" as="geometry"/>
        </mxCell>

        <!-- 4 signals -->
        <mxCell id="KP" value="&lt;b&gt;① Keyphrase&lt;br&gt;Matching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Jaro-Winkler syllable&lt;br&gt;w = 0.05&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="LL">
          <mxGeometry x="20" y="40" width="140" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="SM" value="&lt;b&gt;② Semantic&lt;br&gt;Similarity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;MiniLM-L12 cosine&lt;br&gt;w = 0.20&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="LL">
          <mxGeometry x="180" y="40" width="140" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="PP" value="&lt;b&gt;③ Intent-aware&lt;br&gt;PPR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;α = 0.15, KG edges&lt;br&gt;w = 0.25&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;strokeWidth=2;fontFamily=Times New Roman;fontSize=10;fontColor=#1A237E;" vertex="1" parent="LL">
          <mxGeometry x="340" y="40" width="140" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="CM" value="&lt;b&gt;④ Concept&lt;br&gt;Matching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Ontology type spread&lt;br&gt;w = 0.20&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontFamily=Times New Roman;fontSize=10;" vertex="1" parent="LL">
          <mxGeometry x="500" y="40" width="140" height="75" as="geometry"/>
        </mxCell>

        <!-- PPR mini-graph illustration -->
        <mxCell id="PG1" value="&lt;b&gt;seed&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#283593;fontFamily=Times New Roman;fontSize=9;fontColor=#1A237E;" vertex="1" parent="LL">
          <mxGeometry x="310" y="145" width="60" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="PG2" value="e₁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontFamily=Times New Roman;fontSize=9;" vertex="1" parent="LL">
          <mxGeometry x="400" y="130" width="45" height="30" as="geometry"/>
