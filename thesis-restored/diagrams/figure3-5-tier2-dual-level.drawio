        <mxCell id="PG4" value="e₃" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#9575CD;fontFamily=Times New Roman;fontSize=9;" vertex="1" parent="LL">
          <mxGeometry x="480" y="150" width="45" height="30" as="geometry"/>
