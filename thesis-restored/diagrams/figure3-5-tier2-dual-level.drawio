        <!-- seed/type flow labels -->
        <mxCell id="SF1" value="&lt;i style=&quot;font-size:8px;color:#999&quot;&gt;seeds →&lt;/i&gt;" style="text;html=1;fontSize=8;fontFamily=Times New Roman;" vertex="1" parent="LL">
          <mxGeometry x="145" y="125" width="45" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="SF2" value="&lt;i style=&quot;font-size:8px;color:#999&quot;&gt;entity types →&lt;/i&gt;" style="text;html=1;fontSize=8;fontFamily=Times New Roman;" vertex="1" parent="LL">
          <mxGeometry x="145" y="140" width="70" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="KS1" style="endArrow=classic;strokeColor=#CCC;dashed=1;" edge="1" source="KP" target="PP" parent="LL">
          <mxGeometry relative="1" as="geometry"/>
