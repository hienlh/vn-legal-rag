        <!-- Ratio label -->
        <mxCell id="RL" value="&lt;span style=&quot;font-size:9px;color:#1565C0&quot;&gt;70%&lt;/span&gt;" style="text;html=1;fontSize=9;fontFamily=Times New Roman;" vertex="1" parent="1">
